# MK Foods POS - Environment Configuration
# Copy this file to .env and fill in actual values

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
ENCRYPTION_KEY=your-32-byte-encryption-key-in-production
ARGON2_ITERATIONS=3
ARGON2_MEMORY=65540
ARGON2_PARALLELISM=4

# Database
DATABASE_PATH=./data/pos.db
DATABASE_ENCRYPTION_ENABLED=true

# API Configuration
API_PORT=8000
API_HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
TLS_ENABLED=true
TLS_CERT_PATH=./certs/server.crt
TLS_KEY_PATH=./certs/server.key

# Banking Integration
BANK_GATEWAY_URL=https://api.bankgateway.pk/v1
BANK_API_KEY=your-bank-api-key-here
BANK_API_SECRET=your-bank-api-secret-here
STRIPE_API_KEY=sk_live_your_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Printer Configuration
DEFAULT_PRINTER_MAC=00:00:00:00:00:00
PRINTER_DISCOVERY_TIMEOUT=5000
PRINTER_RECONNECT_INTERVAL=30000

# Cloud Sync
CLOUD_SYNC_ENABLED=true
CLOUD_API_URL=https://api.mkfoods.cloud
CLOUD_API_KEY=your-cloud-api-key
CLOUD_SYNC_INTERVAL=300000

# Audit & Logging
LOG_LEVEL=info
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH=./logs/audit.log

# Compliance
PCI_DSS_MODE=enabled
COMPLIANCE_LEVEL=high
SECURITY_SCAN_INTERVAL=86400000

# Environment
NODE_ENV=production
DEBUG=false
