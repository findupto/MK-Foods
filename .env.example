# MK Foods POS environment reference
# The desktop POS is offline-first. Do not commit real credentials or API secrets.
# Provider credentials should be injected by the backend/OS secret store used by the
# certified payment adapter; the renderer must never receive raw card PAN/CVV.

# Optional local API / integration service
API_PORT=8000
API_HOST=127.0.0.1

# Payment integration placeholders — configure only after onboarding with a real bank,
# 1LINK/Raast participant, or payment gateway. Never use these as fake production URLs.
PAYMENT_PROVIDER=
PAYMENT_ENVIRONMENT=disabled
PAYMENT_MERCHANT_ID=
PAYMENT_API_BASE_URL=
PAYMENT_WEBHOOK_URL=

# Printer runtime
DEFAULT_PRINTER_MAC=
PRINTER_DISCOVERY_TIMEOUT=5000
PRINTER_RECONNECT_INTERVAL=30000

# Cloud sync is optional and must point to a real service owned/approved by MK Foods.
CLOUD_SYNC_ENABLED=false
CLOUD_API_URL=
CLOUD_API_KEY=
CLOUD_SYNC_INTERVAL=300000

# Audit & logging
LOG_LEVEL=info
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH=./logs/audit.log

# Production security/compliance mode
PCI_DSS_MODE=enabled
DEBUG=false
NODE_ENV=production
