# MK Foods POS environment reference
# Never commit real credentials or API secrets.
# Payment credentials belong in the certified backend/provider secret store.

# Optional local API / integration service
API_PORT=8000
API_HOST=127.0.0.1

# Payment integration placeholders
PAYMENT_PROVIDER=
PAYMENT_ENVIRONMENT=disabled
PAYMENT_MERCHANT_ID=
PAYMENT_API_BASE_URL=
PAYMENT_WEBHOOK_URL=

# Printer runtime
DEFAULT_PRINTER_MAC=
PRINTER_DISCOVERY_TIMEOUT=5000
PRINTER_RECONNECT_INTERVAL=30000

# Enterprise cloud synchronization
CLOUD_SYNC_ENABLED=false
CLOUD_API_URL=
CLOUD_API_KEY=
CLOUD_SYNC_INTERVAL=300000

# Cloud service hardening
PORT=8787
NODE_ENV=production
MK_FOODS_REQUIRE_AUTH=true
MK_FOODS_API_KEY=
MK_FOODS_CORS_ORIGIN=https://your-approved-pos-domain.example
MK_FOODS_DATA_DIR=./data
MK_FOODS_MAX_EVENTS=10000
MK_FOODS_RATE_LIMIT=120

# Audit & logging
LOG_LEVEL=info
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH=./logs/audit.log

# Production security/compliance mode
PCI_DSS_MODE=enabled
DEBUG=false
