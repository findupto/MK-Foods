{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MK Foods POS",
  "version": "0.1.0",
  "identifier": "pk.mkfoods.pos",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MK Foods POS",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage"],
    "category": "Business",
    "shortDescription": "Offline-first POS for MK Pizza & Ice Bar",
    "longDescription": "MK Foods offline-first point of sale application.",
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "dialog": {}
  }
}
