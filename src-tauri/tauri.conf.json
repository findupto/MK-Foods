{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MK Foods POS",
  "version": "2.2.0",
  "identifier": "pk.mkfoods.pos",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MK Foods POS",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Business",
    "publisher": "MK Foods",
    "shortDescription": "Offline-first POS for MK Pizza & Ice Bar",
    "longDescription": "MK Foods offline-first point of sale application.",
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "startMenuFolder": "MK Foods POS",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "dialog": null
  }
}
